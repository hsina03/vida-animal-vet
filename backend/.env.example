# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# Clave para firmar la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Base de datos. Para MySQL solo cambia la cadena, por ejemplo:
#   mysql+pymysql://usuario:contraseña@localhost:3306/vida_animal
DATABASE_URL=sqlite:///./vida_animal.db

# Pon true cuando el sitio se sirva con HTTPS
COOKIE_SEGURA=false

# Límite de intentos de inicio de sesión
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

ZONA_HORARIA=America/Ciudad_Juarez

# Cuentas que crea seed.py (contraseñas de al menos 8 caracteres)
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administración Vida Animal II
ADMIN_PASSWORD=
OPERATIVO_USUARIO=lrios
OPERATIVO_NOMBRE=MVZ Laura Ríos
OPERATIVO_PASSWORD=
