# Copia este archivo como backend/.env y ajusta los valores. Nunca subas el .env al repositorio.

PORT=3000
# Zona horaria de la clínica (para calcular "hoy" y la anticipación mínima)
TZ=America/Ciudad_Juarez

DB_HOST=localhost
DB_PORT=3306
DB_USER=vida
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=vida_animal

# Secreto para firmar las sesiones. Usa una cadena larga y aleatoria.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Duración de la sesión del personal
SESSION_HOURS=8

# Contraseñas iniciales para `npm run db:setup`. Si las dejas vacías, el script genera unas aleatorias y las muestra una vez.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
